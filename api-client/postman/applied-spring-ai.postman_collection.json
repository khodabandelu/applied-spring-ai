        {
          "name": "Reject a blank prompt",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Validation response is JSON-compatible\", function () {",
                  "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "    pm.expect(contentType).to.match(/application\\/(?:problem\\+)?json/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
