  "item": [
    {
      "name": "Prompt API",
      "description": "Submit prompts to the Spring AI application and verify its HTTP contract.",
      "item": [
        {
          "name": "Submit a prompt",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has JSON content type\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response contains non-empty model text\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"response\");",
                  "    pm.expect(body.response).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Explain why idempotency matters in distributed systems in one sentence.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/prompts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prompts"
              ]
            },
            "description": "Submits a non-empty prompt. A successful request returns 201 Created with a JSON response."
          },
          "response": [
            {
