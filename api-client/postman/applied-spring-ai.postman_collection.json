    {
      "name": "Operations",
      "description": "Verify that the application is available without exposing sensitive health details.",
      "item": [
        {
          "name": "Check application health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Application status is UP\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"status\", \"UP\");",
                  "    pm.expect(body).not.to.have.property(\"components\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Returns the aggregate application health status. Component details are intentionally hidden."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/actuator/health",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "actuator",
                    "health"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"groups\": [\"liveness\", \"readiness\"],\n  \"status\": \"UP\"\n}"
            }
          ]
        }
      ]
